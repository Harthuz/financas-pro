# Configurações do Supabase & Banco de Dados PostgreSQL
# Se utilizar o Supabase Cloud:
# Opção 1: Conexão via Pooler do Supabase (Recomendado para Serverless / FastAPI)
# DATABASE_URL=postgresql://postgres.[ref]:[SUA_SENHA]@aws-0-[REGIAO].pooler.supabase.com:6543/postgres
# Opção 2: Conexão direta PostgreSQL
# DATABASE_URL=postgresql://postgres:[SUA_SENHA]@db.[ref].supabase.co:5432/postgres

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gastos_db

# Credenciais de API do Supabase (Opcional se utilizar SDK Client Supabase)
SUPABASE_URL=https://<seu-projeto-id>.supabase.co
SUPABASE_ANON_KEY=seu-anon-key-aqui
SUPABASE_SERVICE_ROLE_KEY=seu-service-role-key-aqui

# URL da API Backend
FINANCAS_API_URL=http://localhost:8000

# Integração bancária Pluggy (somente servidor)
PLUGGY_ITEM_ID=
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
