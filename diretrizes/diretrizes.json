  },
  "regras_obrigatorias": [
    {
      "id": "BACKUP_CSV_ANTES_DE_MODIFICAR",
      "prioridade": "CRITICA",
      "descricao": "SEMPRE faça backup em CSV na pasta Downloads (~/Downloads) do dispositivo que estiver fazendo a modificação via MCP ou API ANTES de iniciar qualquer lote de modificação (criação, atualização ou exclusão de gastos, categorias ou contas).",
      "ferramenta_mcp": "fazer_backup_csv",
      "endpoint_api": "GET http://192.168.15.15:8080/api/exportar",
      "destino_local": "~/Downloads/gastos_backup_YYYYMMDD_HHMMSS.csv"
    },
    {
      "id": "VERIFICAR_METADADOS_PRIMEIRO",
      "prioridade": "ALTA",
      "descricao": "Sempre consulte obter_metadados() (ou GET http://192.168.15.15:8080/api/metadados ou GET http://192.168.15.15:8080/api/tudo) antes de inserir ou alterar gastos para verificar as categorias e contas existentes."
    },
    {
      "id": "REUTILIZAR_PADROES",
      "prioridade": "ALTA",
      "descricao": "Utilize exatamente a mesma grafia das categorias (tipo) e métodos de pagamento (conta) já cadastrados."
    },
    {
      "id": "NAO_CRIAR_CATEGORIA_OU_CONTA_SEM_PERMISSAO",
      "prioridade": "ALTA",
      "descricao": "Se o gasto não se encaixar em nenhuma categoria ou conta existente, pause e pergunte expressamente ao usuário antes de criar."
    },
    {
      "id": "NAO_EXIBIR_INVESTIMENTOS_ZERADOS",
      "prioridade": "MEDIA",
      "descricao": "Ao consultar o planejamento (obter_planejamento ou GET /api/planejamento), não liste investimentos com saldo R$ 0,00 em respostas, análises ou previsões. A API já os omite da lista de ativos."
    }
  ],
  "ferramentas_mcp": [
    "fazer_backup_csv",
    "obter_tudo",
    "obter_metadados",
    "listar_gastos",
    "buscar_gastos",
    "adicionar_gasto",
    "atualizar_gasto",
    "excluir_gasto",
    "listar_categorias",
    "adicionar_categoria",
    "listar_contas",
    "adicionar_conta"
  ]
}
