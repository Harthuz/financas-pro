      "mcp_http_streamable": "http://192.168.15.15:8080/mcp",
      "mcp_sse": "http://192.168.15.15:8080/sse",
      "mcp_rest_tools": "http://192.168.15.15:8080/mcp/tools",
      "api_base_8080": "http://192.168.15.15:8080/api",
      "api_get_tudo": "http://192.168.15.15:8080/api/tudo",
      "api_gastos": "http://192.168.15.15:8080/api/gastos",
