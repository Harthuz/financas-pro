      "api_exportar_csv": "http://192.168.15.15:8080/api/exportar",
      "diretrizes_markdown": "http://192.168.15.15:8080/DIRETRIZES.md",
      "diretrizes_json": "http://192.168.15.15:8080/diretrizes.json",
